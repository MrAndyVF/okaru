// OKARU: basado en el fastfetch de Omarchy (omacom/omarchy, MIT) con el kanji 郁 como logo.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/okaru.txt",
    "color": { "1": "blue" },
    "padding": { "top": 2, "right": 6, "left": 2 }
  },
  "display": { "disableLinewrap": true },
  "modules": [
    "break",
    "break",
    { "type": "custom", "format": "\u001b[90m┌──────────────────────Hardware──────────────────────┐" },
    { "type": "host", "key": " PC", "keyColor": "green" },
    { "type": "cpu", "key": "│ ├", "keyColor": "green" },
    { "type": "gpu", "key": "│ ├", "detectionMethod": "pci", "format": "{name}", "keyColor": "green" },
    { "type": "display", "key": "│ ├󱄄", "keyColor": "green" },
    { "type": "disk", "key": "│ ├󰋊", "keyColor": "green" },
    { "type": "memory", "key": "│ ├", "keyColor": "green" },
    { "type": "swap", "key": "└ └󰓡", "keyColor": "green" },
    { "type": "custom", "format": "\u001b[90m└────────────────────────────────────────────────────┘" },
    "break",
    { "type": "custom", "format": "\u001b[90m┌──────────────────────Software──────────────────────┐" },
    { "type": "command", "key": "郁 OS", "keyColor": "blue", "text": "echo \"OKARU $(pacman -Q okaru | cut -d' ' -f2 | cut -d. -f1-3)\"" },
    { "type": "os", "key": "│ ├", "format": "{pretty-name}", "keyColor": "blue" },
    { "type": "kernel", "key": "│ ├", "keyColor": "blue" },
    { "type": "wm", "key": "│ ├", "keyColor": "blue" },
    { "type": "terminal", "key": "│ ├", "keyColor": "blue" },
    { "type": "packages", "key": "│ ├󰏖", "keyColor": "blue" },
    { "type": "wmtheme", "key": "│ ├󰉼", "keyColor": "blue" },
    { "type": "command", "key": "│ ├󰸌", "keyColor": "blue", "text": "printf '\\e[37m●\\e[36m●\\e[35m●\\e[34m●\\e[33m●\\e[32m●\\e[31m●\\e[0m'" },
    { "type": "terminalfont", "key": "└ └", "keyColor": "blue" },
    { "type": "custom", "format": "\u001b[90m└────────────────────────────────────────────────────┘" },
    "break",
    { "type": "custom", "format": "\u001b[90m┌────────────────Age / Uptime / Update───────────────┐" },
    { "type": "command", "key": "󱦟 OS Age", "keyColor": "magenta", "text": "echo \"$(( ($(date +%s) - $(stat -c %W /var/log)) / 86400 )) days\"" },
    { "type": "uptime", "key": "󱫐 Uptime", "keyColor": "magenta" },
    { "type": "command", "key": " Update", "keyColor": "magenta", "text": "date -d \"$(grep upgraded /var/log/pacman.log | tail -1 | sed -E 's/\\[([^]]+)\\].*/\\1/')\" '+%A %d %B %Y %H:%M'" },
    { "type": "custom", "format": "\u001b[90m└────────────────────────────────────────────────────┘" },
    "break"
  ]
}
