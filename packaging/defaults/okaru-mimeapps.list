# OKARU: apps por defecto del escritorio (Hyprland y Niri). Se instala como hyprland-mimeapps.list y
# niri-mimeapps.list en /usr/share/applications; lo que elija el usuario en ~/.config/mimeapps.list manda.
# Los tipos salen del MimeType de assets/dev.okaru.Viewer.desktop (imágenes), dev.okaru.Editor.desktop (texto),
# dev.okaru.Pdf.desktop (PDF), dev.okaru.Player.desktop (video y audio), dev.okaru.Files.desktop (carpetas) y
# dev.okaru.Archive.desktop (comprimidos);
# lo verifica tests/okaru_mimeapps_test.sh.
[Default Applications]
image/png=dev.okaru.Viewer.desktop
image/apng=dev.okaru.Viewer.desktop
