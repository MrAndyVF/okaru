# OKARU: apps por defecto del escritorio (Hyprland y Niri). Se instala como hyprland-mimeapps.list y
# niri-mimeapps.list en /usr/share/applications; lo que elija el usuario en ~/.config/mimeapps.list manda.
# Las imágenes salen del MimeType de assets/dev.okaru.Viewer.desktop (lo verifica
# tests/okaru_mimeapps_test.sh).
[Default Applications]
image/png=dev.okaru.Viewer.desktop
image/apng=dev.okaru.Viewer.desktop
image/jpeg=dev.okaru.Viewer.desktop
image/pjpeg=dev.okaru.Viewer.desktop
image/gif=dev.okaru.Viewer.desktop
image/webp=dev.okaru.Viewer.desktop
image/avif=dev.okaru.Viewer.desktop
image/heic=dev.okaru.Viewer.desktop
image/heif=dev.okaru.Viewer.desktop
image/jxl=dev.okaru.Viewer.desktop
image/bmp=dev.okaru.Viewer.desktop
image/x-bmp=dev.okaru.Viewer.desktop
image/x-dib=dev.okaru.Viewer.desktop
image/vnd.microsoft.icon=dev.okaru.Viewer.desktop
image/x-icon=dev.okaru.Viewer.desktop
image/x-win-bitmap=dev.okaru.Viewer.desktop
image/x-tga=dev.okaru.Viewer.desktop
image/qoi=dev.okaru.Viewer.desktop
image/x-qoi=dev.okaru.Viewer.desktop
image/x-portable-anymap=dev.okaru.Viewer.desktop
