[Unit]
Description=OKARU (郁) shell
Documentation=https://github.com/MrAndyVF/okaru
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
# uwsm no exporta XDG_SESSION_ID; sin ella OKARU no encuentra la sesión de logind (bloqueo, polkit, brillo).
ExecStart=/bin/sh -c 'if [ -z "$XDG_SESSION_ID" ]; then XDG_SESSION_ID=$(loginctl show-user "$USER" -p Display --value); export XDG_SESSION_ID; fi; exec /usr/bin/okaru'
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
