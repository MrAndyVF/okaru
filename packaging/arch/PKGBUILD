# Paquete local de OKARU: compila la rama main del checkout de ~/Projects/okaru (solo lo que está en commits).
# Dos paquetes: okaru-core (bibliotecas privadas, cabeceras, pkg-config y recursos: con él se compilan las apps de
# sus propios repos) y okaru (la shell). Las apps que traiga un paquete de app dependen de la versión exacta del núcleo.
pkgbase=okaru
pkgname=(okaru-core okaru)
pkgver=1.2.4
pkgrel=1
pkgdesc='OKARU (郁): shell de escritorio Wayland'
arch=(x86_64)
url='https://github.com/MrAndyVF/okaru'
license=(MIT)
depends=(bash cairo curl exiv2 fontconfig freetype2 gdk-pixbuf2 git glib2 glibc harfbuzz gsfonts hicolor-icon-theme jemalloc libgcc
         libarchive libglvnd libical libjpeg-turbo libjxl libraw libpipewire libqalculate librsvg libsecret libsndfile libsodium libstdc++ libwebp libwireplumber
         libxkbcommon libxml2 md4c mpv noto-fonts pam polkit pango poppler-glib sdbus-cpp tomlplusplus wl-clipboard
         ttf-bigblueterminal-nerd ttf-jetbrains-mono-nerd wayland)  # BigBlueTermPlus: texto pixelado del bloqueo; JetBrainsMono: fuente de la shell
# Sin paquete -debug: nadie lo instala y solo infla el repositorio.
options=('!debug' '!lto') # sin LTO: enlazar la shell y las apps con LTO era la mitad del tiempo de publicar
makedepends=(meson ninja cmake pkgconf wayland-protocols stb just nlohmann-json)
optdepends=('ddcutil: brillo de monitores externos'
            '7zip: comprimidos 7z/rar con contraseña, 7z cifrados y volúmenes (Comprimidos)'
            'upower: batería y dispositivos de energía'
            'gpu-screen-recorder: grabación de pantalla (widget Captura)'
            'slurp: grabar una región (widget Captura)'
            'networkmanager: red y VPN'
            'pacman-contrib: buscar actualizaciones (Actualizaciones)'
            'flatpak: actualizaciones Flatpak (Actualizaciones) y cursor en apps Flatpak (cursor)'
            'paru: actualizaciones de AUR (Actualizaciones)'
            'yay: actualizaciones de AUR (Actualizaciones)'
            'snapd: actualizaciones Snap (Actualizaciones, AUR)'
            'kdeconnect: conectar el teléfono (panel Teléfono y okaru-files)'
            'sshfs: explorar los archivos del teléfono (panel Teléfono y okaru-files)'
            'android-tools: portapapeles automático del teléfono a la PC (adb, una vez)'
            'claude-code: uso de Claude Code (claudecode, AUR o repo de CachyOS)'
            'jq: uso de Claude Code (claudecode)'
            'python: gestores de cursores e iconos (cursor, icons)'
            'python-wand: convertir cursores de Windows (cursor)'
            'imagemagick: convertir cursores de Windows (cursor)'
            'win2xcur: convertir cursores de Windows (cursor, AUR)'
            'zenity: diálogos de archivos (cursor, icons)'
            'cups: imprimir desde el visor de documentos (okaru-pdf)'
            'gvfs: papelera, recientes, red y unidades extraíbles (okaru-files)'
            'gvfs-smb: carpetas compartidas de Windows y Samba (okaru-files)'
            'gvfs-nfs: carpetas compartidas NFS (okaru-files)'
            'gvfs-mtp: teléfonos y cámaras por cable USB (okaru-files)'
            'gvfs-wsdd: ver los equipos Windows de la red (okaru-files)'
            'ffmpegthumbnailer: miniaturas de video (okaru-files)'
            'libreoffice-fresh: vista previa de documentos de oficina (okaru-files)')
source=("okaru::git+file://${OKARU_REPO:-$HOME/Projects/okaru}#branch=main")
sha256sums=(SKIP)

pkgver() {
  cd okaru
  git describe --long --tags --abbrev=9 --match 'v*' | sed 's/^v//; s/-\([0-9]*\)-g/.r\1.g/'
}

build() {
  arch-meson okaru build -Dtests=disabled
  meson compile -C build
}

# Una sola instalación que se reparte: okaru-core se lleva lo suyo y okaru, el resto.
_stage() {
  [[ -d "$srcdir/stage" ]] || meson install -C "$srcdir/build" --destdir "$srcdir/stage" --quiet
}

package_okaru-core() {
  pkgdesc='OKARU (郁): núcleo compartido (bibliotecas, cabeceras y recursos) de la shell y sus apps'
  rm -rf "$srcdir/stage" # el primer paquete parte de una instalación nueva (repetir makepkg no la encuentra a medias)
  _stage
  local item
  for item in usr/lib/okaru/libokaru-core.so usr/lib/okaru/libokaru-apps.so usr/include/okaru \
    usr/lib/pkgconfig/okaru-core.pc usr/lib/pkgconfig/okaru-apps.pc usr/share/okaru/assets; do
    install -d "$pkgdir/$(dirname "$item")"
    mv "$srcdir/stage/$item" "$pkgdir/$item"
  done
  install -Dm644 okaru/LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
}

package_okaru() {
  depends=("okaru-core=$pkgver-$pkgrel")
  _stage
  # Sin las carpetas que quedaron vacías tras llevarse okaru-core lo suyo.
  find "$srcdir/stage" -mindepth 1 -type d -empty -delete
  cp -a "$srcdir/stage/." "$pkgdir/"
  install -Dm644 okaru/LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
  # Servicio de la sesión (uwsm / niri-session → graphical-session.target) y configuración de fábrica de
  # Hyprland y de Niri, que install.sh copia a ~/.config/hypr o ~/.config/niri según el compositor elegido.
  install -Dm644 okaru/packaging/systemd/okaru.service -t "$pkgdir/usr/lib/systemd/user"
  install -d "$pkgdir/usr/share/okaru/defaults"
  cp -r okaru/packaging/defaults/{hypr,niri,okaru,kitty,fontconfig,fastfetch,starship.toml} "$pkgdir/usr/share/okaru/defaults/"
  local bin="$pkgdir/usr/bin/okaru"
  install -d "$pkgdir"/usr/share/{bash-completion/completions,fish/vendor_completions.d,zsh/site-functions}
  # El binario busca su núcleo en /usr/lib/okaru, que aquí todavía es el del paquete okaru-core.
  local core="$srcdir/../pkg/okaru-core/usr/lib/okaru"
  LD_LIBRARY_PATH="$core" "$bin" completions bash > "$pkgdir/usr/share/bash-completion/completions/okaru"
  LD_LIBRARY_PATH="$core" "$bin" completions fish > "$pkgdir/usr/share/fish/vendor_completions.d/okaru.fish"
  LD_LIBRARY_PATH="$core" "$bin" completions zsh > "$pkgdir/usr/share/zsh/site-functions/_okaru"
}
