[Desktop Entry]
Type=Application
Version=1.5
Name=Files
Name[es]=Archivos
GenericName=File Manager
GenericName[es]=Gestor de archivos
Comment=Browse, organize and manage files, drives, phones and network shares
Comment[es]=Explorar, organizar y gestionar archivos, unidades, teléfonos y carpetas de red
Keywords=files;folders;explorer;manager;browser;disk;network;smb;sftp;
Keywords[es]=archivos;carpetas;explorador;gestor;navegador;disco;red;smb;sftp;
Exec=okaru-files %U
Icon=system-file-manager
Categories=System;Utility;Core;FileTools;FileManager;
MimeType=inode/directory;
StartupWMClass=dev.okaru.Files
Terminal=false
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Name[es]=Ventana nueva
Exec=okaru-files
