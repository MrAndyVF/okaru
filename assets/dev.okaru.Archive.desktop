[Desktop Entry]
Type=Application
Version=1.5
Name=Archives
Name[es]=Comprimidos
GenericName=Archive Manager
GenericName[es]=Gestor de comprimidos
Comment=Open, extract and create zip, 7z, rar, tar and more
Comment[es]=Abrir, extraer y crear zip, 7z, rar, tar y más
Keywords=zip;rar;7z;tar;archive;compress;extract;unzip;
Keywords[es]=zip;rar;7z;tar;comprimir;descomprimir;extraer;archivo;
Exec=okaru-archive %f
Icon=package-x-generic
Categories=Utility;Archiving;Compression;
MimeType=application/zip;application/x-zip-compressed;application/x-7z-compressed;application/vnd.rar;application/x-rar;application/x-rar-compressed;application/x-tar;application/x-compressed-tar;application/x-xz-compressed-tar;application/x-bzip2-compressed-tar;application/x-bzip-compressed-tar;application/x-zstd-compressed-tar;application/x-lzma-compressed-tar;application/x-lz4-compressed-tar;application/x-lzip-compressed-tar;application/gzip;application/x-gzip;application/x-xz;application/x-bzip2;application/x-bzip;application/zstd;application/x-lzma;application/x-lzip;application/x-cpio;application/x-cd-image;application/x-iso9660-image;application/vnd.ms-cab-compressed;application/x-cab;application/x-archive;application/x-ar;application/x-lha;application/x-lzh-compressed;application/x-xar;application/x-rpm;application/x-deb;application/vnd.debian.binary-package;application/x-java-archive;application/x-apple-diskimage;
StartupWMClass=dev.okaru.Archive
Terminal=false
Actions=create;

[Desktop Action create]
Name=New archive
Name[es]=Comprimido nuevo
Exec=okaru-archive
